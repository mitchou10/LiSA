{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "lisa",
      "include-component-in-tag": false,
      "prerelease": true,
      "prerelease-type": "rc",
      "extra-files": [
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "backend/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "services/anonymize/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/lisa/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/lisa/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    }
  }
}
